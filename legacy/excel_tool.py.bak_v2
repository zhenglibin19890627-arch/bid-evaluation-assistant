class ExcelToolError(Exception):
    """Excel 处理过程中的中文可读异常。"""


def check_format_supported(path: str) -> str:
    """检查文件格式，返回扩展名或抛出中文提示。"""
    ext = os.path.splitext(path)[1].lower()
    if ext == ".xlsx":
        return ext
    if ext in (".xls", ".xlsm", ".csv"):
        raise ExcelToolError(
            "检测到文件格式为「%s」。请先在 Excel 中打开该文件，"
            "点击「文件 → 另存为 → Excel 工作簿(.xlsx)」保存后，再放回清单路径重试。" % ext
        )
    raise ExcelToolError("无法识别的文件格式「%s」，请提供 .xlsx 格式的投标机会清单。" % ext)


def _parse_date(value):
    """将公告时间解析为 datetime，兼容多种格式。"""
    if value is None or (isinstance(value, float) and pd.isna(value)):
        return None
    if isinstance(value, datetime):
        return value
    if isinstance(value, pd.Timestamp):
        return value.to_pydatetime()
    if isinstance(value, (int, float)):
        # 可能是 Excel 序列日期
        try:
            return pd.Timestamp(value).to_pydatetime()
        except Exception:
            return None
    text = str(value).strip()
    if not text:
        return None
    # 常见中文日期格式
    for fmt in (
        "%Y-%m-%d %H:%M:%S",
        "%Y-%m-%d %H:%M",
        "%Y-%m-%d",
        "%Y/%m/%d",
        "%Y年%m月%d日",
        "%Y/%m/%d %H:%M:%S",
    ):
        try:
            return datetime.strptime(text, fmt)
        except ValueError:
            continue
    # 兜底：用 pandas 解析
    try:
        return pd.to_datetime(text).to_pydatetime()
    except Exception:
        return None


def load_excel(path: str) -> pd.DataFrame:
    """读取 Excel 清单，返回 DataFrame。"""
    if not os.path.exists(path):
        raise ExcelToolError("未找到投标机会清单文件：%s\n请确认清单路径下存在 .xlsx 清单文件。" % path)

    check_format_supported(path)

    try:
        df = pd.read_excel(path, dtype=str)
    except Exception as e:
        raise ExcelToolError("读取 Excel 失败，请确认文件未被占用且格式正确。详细信息：%s" % e)

    if df.empty:
        raise ExcelToolError("Excel 文件为空，没有可处理的投标机会数据。")

    # 检查必需列
    missing = [c for c in REQUIRED_COLUMNS if c not in df.columns]
    if missing:
        raise ExcelToolError(
            "Excel 缺少以下必需列：%s。\n请确认清单包含：公告时间、公告类型、采购项目名称等列。"
            % "、".join(missing)
        )
    return df


def _detect_header_row(path: str, max_scan: int = 5) -> int:
    """探测表头行：扫描前 max_scan 行，找到含「采购项目名称」的行（1 起）。找不到返回 1。"""
    try:
        head = pd.read_excel(path, header=None, nrows=max_scan, dtype=str)
    except Exception:
        return 1
    for i in range(len(head)):
        row_vals = [str(v) for v in head.iloc[i].tolist() if str(v) and str(v) != "nan"]
        if any("采购项目名称" in v for v in row_vals):
            return i + 1
    return 1


def load_excels_from_dir(list_dir: str) -> dict:
    """
    扫描清单路径下全部 .xlsx 清单并合并（自动探测各文件表头行）。

    多 Sheet 主文件支持（用户单文件工作流：政府采购公告.xlsx 不同地区不同 Sheet）：
    - 文件含多个 Sheet 时逐 Sheet 读取，来源标记为「文件名::Sheet名」；
    - 每个 Sheet 独立探测表头行、独立校验必需列；单个 Sheet 失败不阻塞其他 Sheet。

    返回 {"df": 合并DataFrame(含"来源文件""原始行号"列), "sources": {来源名: 绝对路径},
          "header_rows": {来源名: 表头行号}, "errors": [个别文件的中文错误]}
    - 表头不在第 1 行的文件（如丽水表头在第 3 行）自动适配；
    - 单个文件缺必需列或读取失败：记入 errors，不阻塞其他文件；
    - 全部文件失败或无 .xlsx 时抛出 ExcelToolError（含 .xls/.csv 转换提示）。
    """
    if not os.path.isdir(list_dir):
        raise ExcelToolError("未找到清单路径：%s\n请确认该文件夹存在（放置投标机会清单 Excel 的文件夹）。" % list_dir)
    files = sorted(
        f for f in os.listdir(list_dir)
        if f.lower().endswith(".xlsx") and not f.startswith(("~$", "."))
        # 排除本工具输出文件（初筛结果/历史研判结果），避免被当作来源清单重复扫描
        and "初筛结果" not in f and "研判结果" not in f
        # 排除采集器高亮版输出文件（{地市}政府采购公告_高亮版.xlsx），防止被当清单读入
        and "高亮版" not in f
    )
    if not files:
        other_formats = [
            f for f in os.listdir(list_dir)
            if f.lower().endswith((".xls", ".csv")) and not f.startswith(("~$", "."))
        ]
        if other_formats:
            raise ExcelToolError(
                "检测到文件「%s」格式不支持，本工具仅支持 .xlsx 格式。\n"
                "请先在 Excel 中打开该文件，点击「文件 → 另存为 → Excel 工作簿(.xlsx)」保存后，再放回清单路径重试。"
                % "、".join(other_formats)
            )
        raise ExcelToolError(
            "清单路径下未找到 .xlsx 投标机会清单（路径：%s）。\n请将政府采购云平台导出的清单文件放入该文件夹后重试。"
            % list_dir
        )

    frames, sources, header_rows, errors = [], {}, {}, []
    for fname in files:
        path = os.path.join(list_dir, fname)
        header_row = _detect_header_row(path)
        try:
            df = pd.read_excel(path, dtype=str)
        except Exception as e:
            errors.append("读取「%s」失败：%s" % (fname, e))
            continue
        if df.empty:
            errors.append("「%s」没有数据行，已跳过。" % fname)
            continue
        # 多 Sheet 主文件（不同地区不同 Sheet）：逐 Sheet 读取
        if len(pd.ExcelFile(path).sheet_names) > 1:
            try:
                sheet_frames = _load_multi_sheet(path, fname, errors)
            except Exception as e:
                errors.append("读取「%s」多 Sheet 失败：%s" % (fname, e))
                sheet_frames = []
            for sf in sheet_frames:
                frames.append(sf["df"])
                sources[sf["source"]] = path
                header_rows[sf["source"]] = sf["header_row"]
            continue
        missing = [c for c in REQUIRED_COLUMNS if c not in df.columns]
        if missing:
            errors.append("「%s」缺少必需列：%s（请确认含公告时间、公告类型、采购项目名称等列）。" % (fname, "、".join(missing)))
            continue
        df["来源文件"] = fname
        df["原始行号"] = [header_row + 1 + i for i in range(len(df))]
        frames.append(df)
        sources[fname] = path
        header_rows[fname] = header_row

    if not frames:
        raise ExcelToolError("没有可处理的投标机会清单文件。\n" + "\n".join(errors))

    merged = pd.concat(frames, ignore_index=True) if len(frames) > 1 else frames[0]
    return {"df": merged, "sources": sources, "header_rows": header_rows, "errors": errors}


def _load_multi_sheet(path: str, fname: str, errors: list) -> list:
    """
    逐 Sheet 读取多 Sheet 主文件（政府采购公告.xlsx 等，不同地区不同 Sheet）。
    返回 [{"df": DataFrame, "source": "文件名::Sheet名", "header_row": 行号}]；
    单个 Sheet 缺必需列或空时记入 errors 并跳过（不阻塞其他 Sheet）。
    """
    import pandas as pd
    out = []
    try:
        xls = pd.ExcelFile(path)
        sheet_names = xls.sheet_names
    except Exception as e:
        errors.append("读取「%s」工作表列表失败：%s" % (fname, e))
        return out
    for sn in sheet_names:
        try:
            head = pd.read_excel(path, sheet_name=sn, header=None, nrows=5, dtype=str)
        except Exception:
            continue
        header_row = 1
        for i in range(len(head)):
            row_vals = [str(v) for v in head.iloc[i].tolist() if str(v) and str(v) != "nan"]
            if any("采购项目名称" in v for v in row_vals):
                header_row = i + 1
                break
        try:
            df = pd.read_excel(path, sheet_name=sn, header=header_row - 1, dtype=str)
        except Exception as e:
            errors.append("读取「%s」Sheet「%s」失败：%s" % (fname, sn, e))
            continue
        if df.empty:
            errors.append("「%s」Sheet「%s」没有数据行，已跳过。" % (fname, sn))
            continue
        missing = [c for c in REQUIRED_COLUMNS if c not in df.columns]
        if missing:
            errors.append(
                "「%s」Sheet「%s」缺少必需列：%s（请确认含公告时间、公告类型、采购项目名称等列）。"
                % (fname, sn, "、".join(missing))
            )
            continue
        source = "%s::%s" % (fname, sn)
        df["来源文件"] = source
        df["原始行号"] = [header_row + 1 + i for i in range(len(df))]
        out.append({"df": df, "source": source, "header_row": header_row})
    return out


def _parse_types_file(path: str, errors: list = None) -> list:
    """解析项目类型选择文件，返回选中的大类范围列表 [{"名称": 大类, "子类": [名称...] 或 None(全部)}]。

    兼容三种格式：
    - 新格式：{"scope": [{"大类": "...", "子类": [...]}]} 或 [{"大类": "...", "子类": [...]}]；
    - 旧格式：{"types": ["大类名"...]} / 纯名称列表 / {"selected": [...]} —— 视为所选大类全部子类；
      旧格式名称自动映射到新 17 大类（见 OLD_TYPE_NAME_MAP），无法映射的名称（如"其他"）
      记入 errors 中文警告（不静默丢弃）；新格式（scope 列表）行为不变。
    """
    try:
        with open(path, encoding="utf-8-sig") as f:
            data = json.load(f)
    except Exception:
        return []
    template_names = {t["名称"] for t in PROJECT_TYPES_TEMPLATE}

    def resolve(name: str):
        """旧格式名称 → 新大类名称；已在新模板中则原样返回；无法识别返回 None。"""
        if name in template_names:
            return name
        return OLD_TYPE_NAME_MAP.get(name)

    def warn_unknown(names: list) -> None:
        unknown = sorted({str(n) for n in names if str(n).strip() and resolve(str(n).strip()) is None})
        if unknown and errors is not None:
            for n in unknown:
                errors.append(
                    "旧配置（%s）中存在无法识别的类型：%s，请重新选择项目类型"
                    "（建议先在对话中重新确认项目类型，本次初筛将跳过该类型）。"
                    % (PROJECT_TYPES_SELECTION_FILE, n)
                )

    entries = []
    if isinstance(data, list):
        entries = data
    elif isinstance(data, dict):
        if isinstance(data.get("scope"), list):
            entries = data["scope"]
        elif isinstance(data.get("types"), list):
            names = [str(t) if isinstance(t, str) else str(t.get("名称", "")) for t in data["types"] if t]
            warn_unknown(names)
            return [{"名称": n, "子类": None} for n in (resolve(x) for x in names) if n]
        elif isinstance(data.get("selected"), list):
            names = [str(n) for n in data["selected"] if str(n).strip()]
            warn_unknown(names)
            return [{"名称": n, "子类": None} for n in (resolve(x) for x in names) if n]
    scope = []
    for e in entries:
        if isinstance(e, str):
            # 纯名称列表为旧格式：旧名称映射到新大类，无法识别记中文警告
            n = resolve(e)
            if n:
                scope.append({"名称": n, "子类": None})
            else:
                warn_unknown([e])
        elif isinstance(e, dict):
            big = str(e.get("大类") or e.get("名称") or "").strip()
            subs = e.get("子类")
            if big:
                if isinstance(subs, list):
                    sub_names = [str(s) for s in subs if str(s).strip()]
                    scope.append({"名称": big, "子类": sub_names or None})
                else:
                    scope.append({"名称": big, "子类": None})
    return scope


def _all_subclass_names(big_name: str) -> list:
    """返回大类下全部子类名称（按模板顺序）。"""
    for t in PROJECT_TYPES_TEMPLATE:
        if t["名称"] == big_name:
            return [s["名称"] for s in t.get("子类", [])]
    return []


def load_project_types(path: str = None, errors: list = None) -> list:
    """
    读取用户本次确认的项目类型范围（清单路径/项目类型选择.json），仅返回启用的大类。

    选择文件记录用户选中的大类及子类（P3：模板固定在内置常量，不随业务路径）：
    [{"大类": "医疗健康", "子类": ["影像检查设备"]}]，子类缺省/空数组 = 该大类全部子类。
    返回 [{"名称": 大类, "子类": [名称...] 或 None(全部)}]；
    配置不存在、格式错误或无启用类型时返回 []（初筛将跳过类型过滤）。

    P3.1：旧格式名称（{"types": [...]}/纯名称列表/{"selected": [...]}）自动映射到新 17 大类
    （见 OLD_TYPE_NAME_MAP）；无法映射的名称（如"其他"）不静默丢弃，记入 errors（中文警告，
    含解决建议），由调用方输出给用户。
    """
    if not path or not os.path.exists(path):
        return []
    scope = _parse_types_file(path, errors=errors)
    template_names = {t["名称"] for t in PROJECT_TYPES_TEMPLATE}
    enabled = []
    for item in scope:
        if item["名称"] not in template_names:
            continue
        subs = item.get("子类")
        if subs:
            valid = [s for s in subs if s in set(_all_subclass_names(item["名称"]))]
            # 同类重复出现时合并子类（旧格式多旧名映射到同一大类时保证只生效一次）
            if valid:
                for prev in enabled:
                    if prev["名称"] == item["名称"]:
                        prev["子类"] = sorted(set(prev.get("子类") or []) | set(valid))
                        break
                else:
                    enabled.append({"名称": item["名称"], "子类": valid})
                continue
            subs = None
        for prev in enabled:
            if prev["名称"] == item["名称"]:
                break
        else:
            enabled.append({"名称": item["名称"], "子类": subs})
    return enabled


def list_all_project_types(path: str = None) -> list:
    """
    列出全部项目类型（大类+子类），供对话展示给用户。

    path 为清单路径/项目类型选择.json：存在时返回模板并标记其中已选大类启用状态；
    不存在时返回内置模板（全部未启用）。返回 [{"名称", "子类": [...], "启用"}]。
    """
    enabled_bigs = {item["名称"] for item in load_project_types(path)} if path else set()
    return [
        {"名称": t["名称"], "子类": [s["名称"] for s in t.get("子类", [])], "启用": t["名称"] in enabled_bigs}
        for t in PROJECT_TYPES_TEMPLATE
    ]


def save_selected_types(scope, path: str = None) -> str:
    """
    将用户本次选择的项目类型范围写入「清单路径/项目类型选择.json」（P3 起）。

    支持两种入参：
    - 二级结构（推荐）：scope = {"教育培训与设备": ["教育信息化"], "医疗健康": []}，
      值为空数组或 None 表示该大类全部子类；
    - 兼容旧格式：scope = ["教育培训与设备", "医疗健康"]（仅大类，全部子类）。

    文件内容：{"scope": [{"大类": "...", "子类": [...]}]}，可直接用记事本增删。
    """
    if not path:
        raise ExcelToolError(
            "无法保存项目类型选择：未提供输出路径。\n"
            "请传入清单路径下的文件路径，如 os.path.join(清单路径, '项目类型选择.json')。"
        )
    template_names = [t["名称"] for t in PROJECT_TYPES_TEMPLATE]
    scope_list = []
    if isinstance(scope, dict):
        for big in template_names:
            if big in scope:
                subs = scope[big]
                if isinstance(subs, list) and subs:
                    scope_list.append({"大类": big, "子类": [str(s) for s in subs]})
                else:
                    scope_list.append({"大类": big, "子类": []})
    elif isinstance(scope, (list, tuple)):
        for big in template_names:
            if big in set(str(s) for s in scope):
                scope_list.append({"大类": big, "子类": []})
    cfg = {
        "说明": "本次研判选择的项目类型范围（大类+子类，空数组=该大类全部子类；由 AI 在对话中确认后写入，每次研判可不同；可直接用记事本增删）。",
        "scope": scope_list,
    }
    os.makedirs(os.path.dirname(path) or ".", exist_ok=True)
    try:
        with open(path, "w", encoding="utf-8") as f:
            json.dump(cfg, f, ensure_ascii=False, indent=2)
    except Exception as e:
        raise ExcelToolError("保存项目类型选择文件失败（%s）：%s" % (path, e))
    return path


def save_time_range(days, path: str = None) -> str:
    """
    将用户本次选择的时间范围写入「清单路径/时间范围选择.json」。

    days 为天数（如 5/7/15/30/90）；传 None/0/"不限"/"全部" 表示不限制公告时间（不做强制限定）。
    文件内容：{"days": 5} 或 {"days": null}（null = 不限）。
    """
    if not path:
        raise ExcelToolError(
            "无法保存时间范围选择：未提供输出路径。\n"
            "请传入清单路径下的文件路径，如 os.path.join(清单路径, '时间范围选择.json')。"
        )
    if days in (None, 0, "不限", "全部", "不限制"):
        value = None
    else:
        try:
            value = int(days)
        except (TypeError, ValueError):
            value = None
    cfg = {
        "说明": "本次研判选择的公告时间范围（天）；null 表示不限制公告时间。由 AI 在对话中确认后写入，每次研判可不同；可直接用记事本修改。",
        "days": value,
    }
    os.makedirs(os.path.dirname(path) or ".", exist_ok=True)
    try:
        with open(path, "w", encoding="utf-8") as f:
            json.dump(cfg, f, ensure_ascii=False, indent=2)
    except Exception as e:
        raise ExcelToolError("保存时间范围选择文件失败（%s）：%s" % (path, e))
    return path


def load_time_range(path: str = None):
    """读取时间范围选择文件，返回天数（int）；未配置/格式错误/不限 时返回 None（不限时间）。"""
    if not path or not os.path.exists(path):
        return None
    try:
        with open(path, encoding="utf-8-sig") as f:
            data = json.load(f)
    except Exception:
        return None
    days = data.get("days") if isinstance(data, dict) else None
    if days in (None, 0, "", "不限", "全部", "不限制"):
        return None
    try:
        return int(days)
    except (TypeError, ValueError):
        return None


def _has_filled_content(company_text: str) -> bool:
    """判断公司介绍是否已填写实际内容：任意一行冒号后有非空内容视为已填写。"""
    if not company_text:
        return False
    for line in company_text.splitlines():
        if "：" in line:
            _, _, tail = line.partition("：")
        elif ":" in line:
            _, _, tail = line.partition(":")
        else:
            continue
        if tail.strip():
            return True
    return False


def extract_company_keywords(company_text: str) -> list:
    """从公司介绍文本中抽取业务/产品相关关键词（2 字及以上中文词），用于相关性初判。"""
    if not company_text:
        return []
    # 剔除模板引导说明行（> 开头的 blockquote），避免空模板被误判为公司业务内容
    lines = [ln for ln in company_text.splitlines() if not ln.lstrip().startswith(">")]
    company_text = "\n".join(lines)
    # 去除非中文字符和常见停用词
    text = re.sub(r"[^\u4e00-\u9fa5a-zA-Z0-9]+", " ", company_text)
    stopwords = {
        "我们", "公司", "有限公司", "本司", "企业", "业务", "产品", "服务",
        "以及", "以及的", "以及公司", "主要", "提供", "包括", "拥有", "具备",
        "相关", "各项", "以及本", "以及主", "以下", "如下", "相应", "领域",
    }
    words = set()
    # 中文双字词
    for m in re.findall(r"[\u4e00-\u9fa5]{2,8}", text):
        w = m.strip()
        if w and w not in stopwords and len(w) >= 2:
            words.add(w)
    # 英文/数字词
    for m in re.findall(r"[a-zA-Z0-9]{2,}", text):
        words.add(m.lower())
    return sorted(words)


def _stringify(value) -> str:
    if value is None:
        return ""
    text = str(value).strip()
    if text.lower() in ("nan", "none", "null"):
        return ""
    return text


def classify_project(name: str, buyer: str = "", announce_type: str = "") -> dict:
    """
    按 17 大类 × 84 子类关键词体系对单个项目/业绩名称分类（初筛与业绩表共用）。

    - 关键词匹配（项目名命中子类关键词）→ 行业域兜底（采购人+行业词）→ 电子卖场公告规则；
    - 专属子类互斥：命中"食堂劳务外包"时不再标记"食堂与食材配送/劳务外包与派遣"；
    - 全部未命中 → 暂归"专业技术服务"（pending=True，AI 人工确认）。

    返回 {"pairs": [(大类, 子类)...], "display": "大类（子类）…", "pending": bool}
    """
    proj = _stringify(name)
    buyer = _stringify(buyer)
    atype = _stringify(announce_type)
    matched_pairs = []
    hit_kws = {}
    for big in PROJECT_TYPES_TEMPLATE:
        for sub in big.get("子类", []):
            kws = [k for k in sub["关键词"] if k in proj]
            if kws:
                matched_pairs.append((big["名称"], sub["名称"]))
                hit_kws[(big["名称"], sub["名称"])] = kws
    # 专属子类互斥：命中"食堂劳务外包"时，不再重复标记"食堂与食材配送""劳务外包与派遣"
    if any(b == "后勤物业与餐饮" and s == "食堂劳务外包" for b, s in matched_pairs):
        matched_pairs = [
            (b, s) for b, s in matched_pairs
            if not (b == "后勤物业与餐饮" and s in ("食堂与食材配送", "劳务外包与派遣"))
        ]
    # 电子卖场公告 → 电子卖场类（公告类型为"电子卖场公告"即归入，不受项目名限制）
    if atype == "电子卖场公告" and not any(b == "电子卖场类" for b, _ in matched_pairs):
        matched_pairs.append(("电子卖场类", "电子卖场类"))
    # 行业域兜底：采购人属某行业（行业词为空=该行业不限制，如教育域全部挂教育标签）→ 归入对应行业大类
    for type_name, buyer_kws, it_kws in SECTOR_BUYER_KWS:
        if not any(b == type_name for b, _ in matched_pairs) and any(k in buyer for k in buyer_kws) and (not it_kws or any(k in proj for k in it_kws)):
            matched_pairs.append((type_name, type_name))
    pending = not matched_pairs
    if pending:
        matched_pairs = [("专业技术服务", "专业技术服务")]
    grouped = {}
    for big, sub in matched_pairs:
        grouped.setdefault(big, []).append(sub)
    display_parts = []
    for big, subs in grouped.items():
        if len(subs) == 1 and subs[0] == big:
            display_parts.append(big)
        elif len(subs) == 1:
            display_parts.append("%s（%s）" % (big, subs[0]))
        else:
            display_parts.append("%s（%s）" % (big, "、".join(subs)))
    return {"pairs": matched_pairs, "display": "、".join(display_parts), "pending": pending, "hits": hit_kws}


def filter_screening(
    df: pd.DataFrame,
    company_text: str = "",
    days: int = None,
    today: datetime = None,
    project_types: list = None,
) -> pd.DataFrame:
    """
    初筛：时间范围（可选，不强制）+ 公告类型合法 + 项目类型命中。

    days 为 None/0 时不做时间过滤（不限公告时间，全部按"时间通过"处理）；
    否则仅保留公告时间在 days 天以内的项目。

    返回 DataFrame，新增列：
    - 项目类型: 命中的已选项目类型名称（未命中为空）
    - 初筛结果: 通过 / 时间不符 / 类型不符 / 项目类型不符 / 时间缺失
    - 初筛原因: 各过滤项的明确原因（如"公告超过 N 天""不在已选项目类型范围"），通过项为"通过"
    - 相关性初判: 相关 / 待确认（软标记，不参与过滤，仅作研判提示）
    - 相关性依据: 命中的公司关键词，或未命中的说明

    相关性为软标记：不命中也不剔除（避免因关键词覆盖不全误杀项目），
    由 AI 在对话中向用户确认后决定是否研判。

    project_types 为用户确认的启用类型列表（见 load_project_types）；
    为 None 时自动读取清单路径/项目类型选择.json；无启用类型时跳过类型过滤。
    """
    if today is None:
        today = datetime.now()
    # days 为 None/0 = 不限制时间（不做时间过滤，全部按时间通过）
    cutoff = None if not days else today - timedelta(days=days)

    if project_types is None:
        project_types = load_project_types()

    company_keywords = extract_company_keywords(company_text)
    has_company_data = _has_filled_content(company_text)

    df = df.copy()
    results = []
    rel = []
    rel_why = []
    matched_type_names = []
    type_pending_flags = []

    for _, row in df.iterrows():
        # 1) 时间条件（不限制时跳过；限制时公告时间缺失仍标记"时间缺失"）
        if cutoff is None:
            results.append("时间通过")
        else:
            dt = _parse_date(row.get("公告时间"))
            if dt is None:
                results.append("时间缺失")
            else:
                # 时间比较统一到日期
                if dt.timestamp() >= cutoff.timestamp():
                    results.append("时间通过")
                else:
                    results.append("时间不符")

        # 2) 类型条件
        atype = _stringify(row.get("公告类型"))
        if atype in VALID_ANNOUNCE_TYPES:
            type_ok = True
        else:
            type_ok = False
            if results[-1] == "时间通过":
                results[-1] = "类型不符"

        # 3) 项目类型过滤（按清单路径/项目类型选择.json 中用户本次确认的大类+子类范围）
        #    项目类型标注用全量模板（17 大类 × 子类）关键词匹配（未选中的类型也标注），过滤只用已选范围
        proj = _stringify(row.get("采购项目名称"))
        buyer = _stringify(row.get("采购人"))
        atype = _stringify(row.get("公告类型"))
        cls = classify_project(proj, buyer=buyer, announce_type=atype)
        matched_pairs = cls["pairs"]
        type_pending_flag = cls["pending"]
        # 过滤：是否命中用户本次选择的大类+子类范围（子类为空数组=大类全部子类）
        if project_types and results[-1] == "时间通过" and type_ok:
            allowed = set()
            for item in project_types:
                subs = item.get("子类")
                if subs is None:
                    allowed.add((item["名称"], None))  # 大类级：命中该大类任意子类均可
                else:
                    allowed.update((item["名称"], s) for s in subs)
            hit_selected = False
            for big, sub in matched_pairs:
                if (big, None) in allowed or (big, sub) in allowed:
                    hit_selected = True
                    break
            if not hit_selected:
                # 未分类项目不剔除：保留并标记"类型待确认"，由 AI 在对话中列出人工确认，
                # 防止未分类项目在初筛时被静默遗漏（与相关性"待确认"同口径）
                if type_pending_flag:
                    results[-1] = "类型待确认"
                else:
                    results[-1] = "项目类型不符"
        matched_type_names.append(cls["display"])
        type_pending_flags.append(type_pending_flag)

        # 4) 相关性初判（软标记：命中"相关"；未命中或资料不齐"待确认"，不剔除）
        if has_company_data and company_keywords and proj:
            hits = [k for k in company_keywords if k in proj]
            if hits:
                rel.append("相关")
                rel_why.append("命中词：" + "、".join(sorted(hits)))
            else:
                rel.append("待确认")
                rel_why.append("无公司关键词命中（关键词：" + "、".join(company_keywords[:12]) + "…）")
        else:
            rel.append("待确认")
            rel_why.append("企业资料未填写完整，暂无法初判")

    df["项目类型"] = matched_type_names
    df["相关性初判"] = rel
    df["相关性依据"] = rel_why

    # 综合判定：时间+类型+项目类型 三项同时通过才进入候选清单
    # 相关性不参与过滤，仅作软标记；未分类项目不剔除（类型待确认，由 AI 人工确认）
    def decide(r):
        if r == "时间不符":
            return "时间不符", "公告超过 5 天"
        if r == "类型不符":
            return "类型不符", "公告类型不符"
        if r == "时间缺失":
            return "时间缺失", "公告时间缺失"
        if r == "类型待确认":
            return "通过", "项目类型未分类（暂归专业技术服务），待人工确认"
        if r == "项目类型不符":
            enabled_names = "、".join(
                (t["名称"] if t.get("子类") is None else "%s（%s）" % (t["名称"], "、".join(t["子类"])))
                for t in project_types
            ) if project_types else ""
            return "项目类型不符", "不在已选项目类型范围（%s）" % enabled_names
        return "通过", "通过"

    df["初筛结果"] = [decide(r)[0] for r in results]
    df["初筛原因"] = [decide(r)[1] for r in results]
    df["类型待确认"] = type_pending_flags
    return df


def filter_passed(df: pd.DataFrame) -> pd.DataFrame:
    """仅保留初筛通过（时间+类型+项目类型均合法）的候选。"""
    return df[df["初筛结果"] == "通过"].copy()


# 初筛结果 Excel 输出列（P3：{时间}_初筛结果.xlsx，各清单一个 sheet）
SCREENING_EXCEL_COLUMNS = [
    "项目类型",
    "公告时间",
    "公告类型",
    "所在区县",
    "采购人",
    "采购项目名称",
    "预算金额(元)",
    "中标金额(元)",
    "中标单位",
    "代理机构",
    "地址链接URL",
    "相关性初判",
    "相关性依据",
    "初筛结果",
    "初筛原因",
    "来源文件",
    "原始行号",
]
# 输出列显示名：相关性依据 → 相关性(命中词)（验收口径：含初筛结果/初筛原因/相关性(命中词)/来源列）
SCREENING_EXCEL_DISPLAY = {"相关性依据": "相关性(命中词)"}


def _safe_sheet_title(name: str) -> str:
    """工作表名：去扩展名 + 去非法字符 + 截断 31 字符（Excel 限制）。"""
    title = os.path.splitext(os.path.basename(name))[0]
    title = re.sub(r"[\\/:*?\[\]]", "_", title)
    title = title[:31] or "清单"
    return title


def write_screening_excel(
    df: pd.DataFrame,
    list_dir: str,
    sources: dict,
    timestamp: str,
    output_path: str = None,
    extra_columns: list = None,
) -> str:
    """
    输出初筛结果 Excel（P3）：{时间}_初筛结果.xlsx，放在清单路径下。

    - 每个来源清单一个 sheet（表名取清单文件名去扩展名），含全量行；
    - 每行含：初筛结果 / 初筛原因 / 相关性初判 / 相关性依据(命中词) / 来源文件 / 原始行号；
    - extra_columns（可选，默认 None）：追加到输出列末尾的列名列表
      （增量模式下传 ["初筛状态", "研判状态"]；不传时行为与既有完全一致）；
    - 返回输出文件绝对路径；保存失败时抛出中文提示（含被 Excel 占用的处理建议）。
    """
    if output_path is None:
        output_path = os.path.join(list_dir, "%s_初筛结果.xlsx" % timestamp)
    os.makedirs(os.path.dirname(output_path) or ".", exist_ok=True)

    from openpyxl import Workbook

    try:
        wb = Workbook()
        wb.remove(wb.active)
        used_titles = set()
        # 汇总 sheet（置顶）：仅保留初筛通过且相关性为"待确认"的项目，供用户集中确认
        pending = df[(df["初筛结果"] == "通过") & (df["相关性初判"] == "待确认")]
        if len(pending):
            _write_sheet(wb, "汇总", pending, extra_columns)
            used_titles.add("汇总")
        # 无来源信息的行归入"合并清单"sheet
        source_names = [n for n in sources.keys()]
        if source_names:
            for fname in source_names:
                sub = df[df["来源文件"] == fname]
                title = _safe_sheet_title(fname)
                while title in used_titles:
                    title = title + "_2"
                used_titles.add(title)
                _write_sheet(wb, title, sub, extra_columns)
            # 来源文件不在 sources 中的行（理论不会出现，兜底）
            rest = df[~df["来源文件"].isin(source_names)]
            if len(rest):
                _write_sheet(wb, "合并清单", rest, extra_columns)
        else:
            _write_sheet(wb, "清单", df, extra_columns)
        wb.save(output_path)
    except PermissionError:
        raise ExcelToolError(
            "保存初筛结果失败：%s 可能已被 Excel 打开占用，请关闭 Excel 后重试。" % output_path
        )
    except Exception as e:
        raise ExcelToolError("保存初筛结果失败（%s）：%s" % (output_path, e))
    finally:
        try:
            wb.close()
        except Exception:
            pass
    return output_path


def _write_sheet(wb, title: str, df: pd.DataFrame, extra_columns: list = None) -> None:
    """将 DataFrame 写入工作簿的单个 sheet（只写初筛结果相关列；extra_columns 追加到末尾）。"""
    ws = wb.create_sheet(title)
    cols = [c for c in SCREENING_EXCEL_COLUMNS if c in df.columns]
    for c in (extra_columns or []):
        if c in df.columns and c not in cols:
            cols.append(c)
    headers = [SCREENING_EXCEL_DISPLAY.get(c, c) for c in cols]
    ws.append(headers)
    for _, row in df.iterrows():
        ws.append([_stringify(row.get(c)) for c in cols])
    # 简单列宽（不冻结，保持轻量）
    from openpyxl.utils import get_column_letter
    for i, h in enumerate(headers, start=1):
        width = min(max(len(h) * 2 + 2, 12), 40)
        ws.column_dimensions[get_column_letter(i)].width = width


def write_screening_back_to_main(df: pd.DataFrame, sources: dict, main_file: str = None) -> bool:
    """
    初筛结果回写主文件（多 Sheet 主文件工作流：不新建初筛结果 Excel）。

    - 来源名为「文件名::Sheet名」时，按 URL 定位主文件对应 Sheet 的行，
      回写「初筛结果 / 初筛原因 / 相关性(命中词)」三列；
    - 主文件参数缺省时从 sources 推断唯一文件路径；
    - 返回值：True=已回写（至少一个 Sheet 生效）；False=未回写（非多 Sheet 来源或主文件不可写）。
    """
    if not sources or df is None or df.empty:
        return False
    # 仅处理多 Sheet 来源（来源名含 ::）
    sheet_sources = {src: path for src, path in sources.items() if "::" in str(src)}
    if not sheet_sources:
        return False

    # 推断主文件：所有 Sheet 来源指向同一文件（如 政府采购公告.xlsx）
    paths = set(sheet_sources.values())
    if len(paths) != 1:
        return False
    main_path = paths.pop()
    if main_file and os.path.normpath(main_file) != os.path.normpath(main_path):
        main_path = main_file

    from openpyxl import load_workbook

    try:
        wb = load_workbook(main_path)
    except Exception as e:
        raise ExcelToolError("打开主文件「%s」失败，请确认文件未被 Excel 占用。详细信息：%s" % (main_path, e))

    # 按来源分组：来源名 → 表头行号（探测）
    src_header = {}
    for src in sheet_sources:
        fname, _, sn = src.partition("::")
        if sn not in wb.sheetnames:
            continue
        ws = wb[sn]
        header_row = None
        for r in range(1, min(ws.max_row, 5) + 1):
            vals = [str(ws.cell(r, c).value or "").strip() for c in range(1, ws.max_column + 1)]
            if "采购项目名称" in vals:
                header_row = r
                break
        if header_row is None:
            continue
        src_header[src] = (ws, header_row)

    if not src_header:
        wb.close()
        return False

    # 构建 URL → (Sheet, 行号) 映射
    url_to_loc = {}
    for src, (ws, header_row) in src_header.items():
        col_of = {}
        for c in range(1, ws.max_column + 1):
            name = str(ws.cell(header_row, c).value or "").strip()
            if name:
                col_of.setdefault(name, c)
        url_col = col_of.get("地址链接URL")
        if not url_col:
            continue
        for r in range(header_row + 1, ws.max_row + 1):
            url = str(ws.cell(r, url_col).value or "").strip()
            if url:
                url_to_loc[url] = (ws, col_of, r)

    written = 0
    for _, row in df.iterrows():
        url = _stringify(row.get("地址链接URL")).strip()
        if not url or url not in url_to_loc:
            continue
        ws, col_of, r = url_to_loc[url]
        fields = {
            "初筛结果": row.get("初筛结果"),
            "初筛原因": row.get("初筛原因"),
            "相关性(命中词)": row.get("相关性依据"),
        }
        for col_name, val in fields.items():
            c = col_of.get(col_name)
            if c is not None:
                ws.cell(r, c).value = _stringify(val) if val is not None else ""
        written += 1

    if written:
        try:
            wb.save(main_path)
        except PermissionError:
            wb.close()
            raise ExcelToolError(
                "保存主文件失败：%s 可能已被 Excel 打开占用，请关闭 Excel 后重试。" % main_path
            )
    wb.close()
    return written > 0


def build_screening_md_table(df: pd.DataFrame) -> str:
    """
    生成初筛汇总 markdown 表格（对话中初筛汇报用；研判报告已不含初筛汇总，仅逐项目研判）。

    列：项目类型 | 公告时间 | 公告类型 | 采购项目名称 | 相关性(命中词) | 初筛结果 | 初筛原因 | 来源
    返回 markdown 表格文本；df 为空时返回"（无初筛数据）"。
    """
    if df is None or df.empty:
        return "（无初筛数据）"
    header = ["项目类型", "公告时间", "公告类型", "采购项目名称", "相关性(命中词)", "初筛结果", "初筛原因", "来源"]
    lines = ["| " + " | ".join(header) + " |", "|" + "---|" * len(header)]
    for _, row in df.iterrows():
        cells = [
            _stringify(row.get("项目类型")),
            _stringify(row.get("公告时间")),
            _stringify(row.get("公告类型")),
            _stringify(row.get("采购项目名称")),
            _stringify(row.get("相关性依据")),
            _stringify(row.get("初筛结果")),
            _stringify(row.get("初筛原因")),
            "%s / 行%s" % (_stringify(row.get("来源文件")), _stringify(row.get("原始行号"))),
        ]
        cells = [c.replace("|", "｜").replace("\n", " ") for c in cells]
        lines.append("| " + " | ".join(cells) + " |")
    return "\n".join(lines)


def write_result(
    source_paths,
    output_path: str,
    result_map: dict,
    extra_columns: list = None,
) -> None:
    """
    将研判结果回写到新 Excel：每个来源清单一个工作表，保留原表结构与格式，
    新增「研判结果」列（及 extra_columns 指定的列，如"项目类型"）。

    【P3 说明】本函数自 P3 起不再被 SKILL.md 调用（研判结论改输出 md 报告），
    仅保留以兼容历史脚本。

    参数：
    - source_paths: 来源清单 {文件名: 绝对路径}；兼容传单个字符串路径（自动包一层）
    - output_path: 输出文件路径
    - result_map: {(来源文件名, Excel行号): {"项目类型": str, "研判结果": str}}
      兼容旧格式：单文件时 key 可为 {Excel行号: 文本}，内部自动转换
    - extra_columns: 在「研判结果」之前插入的列头列表（默认 ["项目类型"]）
    """
    if isinstance(source_paths, str):
        source_paths = {os.path.basename(source_paths): source_paths}

    if not source_paths:
        raise ExcelToolError("无法回写：未提供任何来源清单文件。")

    extra_columns = extra_columns or ["项目类型"]
    from openpyxl import load_workbook

    # 规范化 result_map：key -> (来源文件名, 行号)
    norm = {}
    for key, val in result_map.items():
        if isinstance(key, tuple) and len(key) == 2:
            fname, row_idx = key
        else:
            fname, row_idx = list(source_paths.keys())[0], key
        if isinstance(val, str):
            val = {"研判结果": val}
        norm[(fname, int(row_idx))] = val

    os.makedirs(os.path.dirname(output_path) or ".", exist_ok=True)
    out = None  # 输出工作簿

    for fname, path in source_paths.items():
        if not os.path.exists(path):
            raise ExcelToolError("无法回写：源文件不存在：%s" % path)
        try:
            wb = load_workbook(path)
        except Exception as e:
            raise ExcelToolError("打开源文件「%s」失败，请确认文件未被占用。详细信息：%s" % (fname, e))

        ws = wb.active
        # 找到表头所在行
        header_row = None
        for r in range(1, min(ws.max_row, 5) + 1):
            vals = [str(ws.cell(row=r, column=c).value or "") for c in range(1, ws.max_column + 1)]
            if any("采购项目名称" in v for v in vals):
                header_row = r
                break
        if header_row is None:
            header_row = 1

        # 在「研判结果」前插入 extra_columns（从最后一列之后开始写）
        new_col = ws.max_column + 1
        col_of = {}
        for col_name in list(extra_columns) + ["研判结果"]:
            ws.cell(row=header_row, column=new_col, value=col_name)
            if header_row > 1:
                src_cell = ws.cell(row=header_row, column=1)
                new_cell = ws.cell(row=header_row, column=new_col)
                try:
                    new_cell.font = src_cell.font.copy()
                    new_cell.fill = src_cell.fill.copy()
                    new_cell.border = src_cell.border.copy()
                    new_cell.alignment = src_cell.alignment.copy()
                except Exception:
                    pass
            col_of[col_name] = new_col
            new_col += 1

        # 回写结果（行号从表头+1 开始）
        for (src_fname, row_idx), vals in norm.items():
            if src_fname != fname:
                continue
            for col_name, value in vals.items():
                if col_name in col_of:
                    ws.cell(row=row_idx, column=col_of[col_name], value=value)

        sheet_title = fname.rsplit(".", 1)[0][:31]

        if out is None:
            out = wb
            try:
                out.active.title = sheet_title
            except Exception:
                pass
        else:
            import copy as _copy
            try:
                out.create_sheet(sheet_title)
            except Exception:
                out.create_sheet(sheet_title + "_" + str(len(out.sheetnames)))
            dst = out[out.sheetnames[-1]]
            for row in ws.iter_rows():
                for cell in row:
                    nc = dst[cell.coordinate]
                    nc.value = cell.value
                    nc.font = _copy.copy(cell.font)
                    nc.fill = _copy.copy(cell.fill)
                    nc.border = _copy.copy(cell.border)
                    nc.alignment = _copy.copy(cell.alignment)
                    nc.number_format = cell.number_format
            for rng in ws.merged_cells.ranges:
                dst.merge_cells(str(rng))
            for col_letter, dim in ws.column_dimensions.items():
                if dim.width:
                    dst.column_dimensions[col_letter].width = dim.width
            wb.close()

    try:
        out.save(output_path)
    except PermissionError:
        raise ExcelToolError(
            "保存结果文件失败：%s 可能已被 Excel 打开占用，请关闭 Excel 后重试。" % output_path
        )
    except Exception as e:
        raise ExcelToolError("保存结果文件失败：%s" % e)
    finally:
        if out is not None:
            try:
                out.close()
            except Exception:
                pass


def build_result_map(df: pd.DataFrame, results: list) -> dict:
    """
    将研判结果（按行顺序）绑回原表行号。

    参数：
    - df: 带原始 Excel 行号列（如含"原始行号"）的 DataFrame
    - results: 与 df 行顺序一致的研判结果列表
    返回 {Excel行号: 结果文本}
    """
    if len(results) != len(df):
        raise ExcelToolError("研判结果数量与候选数量不一致，无法回写。")
    if "原始行号" not in df.columns:
        raise ExcelToolError("缺少原始行号列，无法正确回写。")
    return {int(rid): text for rid, text in zip(df["原始行号"], results)}