# -*- coding: utf-8 -*-
"""
excel_tool.py —— Excel 读取、初筛过滤、初筛结果输出、项目类型选择

功能：
1. 读取投标机会清单 Excel（.xlsx），识别字段（多清单合并 + 表头行自动探测）；
2. 初筛：公告 5 天内 + 公告类型合法 + 项目类型命中 + 与公司业务相关（同时满足）；
3. 输出「初筛结果」Excel（{时间}_初筛结果.xlsx，各清单一个 sheet，放清单路径）；
4. 项目类型：17 大类 + 84 子类模板为脚本内置常量（P3 起不随业务路径），用户每次选择的结果
   写入「清单路径/项目类型选择.json」；
5. 提供初筛汇总 markdown 表格生成函数（研判报告 md 用）。

说明：
- 仅支持 .xlsx；若检测到 .xls 或 .csv，给出中文提示"请另存为 .xlsx 格式后重试"。
- 项目类型范围由「清单路径/项目类型选择.json」配置（用户在初筛前确认）；配置缺失或
  无启用类型时自动跳过类型过滤。
- 相关性为软标记：命中"相关"，未命中或资料不齐"待确认"，一律不剔除。
"""

from __future__ import annotations

import json
import os
import re
from datetime import datetime, timedelta

import pandas as pd

